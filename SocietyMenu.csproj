<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>

        <!-- Change this from 'embedded' to 'portable' or 'none' for releases -->
        <DebugType>portable</DebugType>
    
        <!-- Enable deterministic builds and map local paths to a generic root -->
        <Deterministic>true</Deterministic>
        <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <AssemblyName>KEWLMENU</AssemblyName>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Version>1.0.0</Version>
        <Description>KEWLMENU by omqItzrlyjames for Among Us</Description>
        <Authors>omqItzrlyjames</Authors>
        <UnityBaseLibsDirectory>C:\Program Files\Unity\Hub\Editor\2022.3.62f3\Editor\Data\PlaybackEngines\windowsstandalonesupport\Variations\il2cpp\Managed</UnityBaseLibsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include=".\Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Nocturne\Menu\NocturneGuiHost.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18" PrivateAssets="all" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NVorbis" Version="0.10.5" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="routines\" />
    </ItemGroup>

    <ItemGroup>
        <RuntimeDependency Include="$(NuGetPackageRoot)nvorbis\0.10.5\lib\netstandard2.0\NVorbis.dll" />
        <RuntimeDependency Include="$(NuGetPackageRoot)naudio\2.2.1\lib\net6.0\NAudio.dll" />
        <RuntimeDependency Include="$(NuGetPackageRoot)naudio.core\2.2.1\lib\netstandard2.0\NAudio.Core.dll" />
        <RuntimeDependency Include="$(NuGetPackageRoot)naudio.winmm\2.2.1\lib\netstandard2.0\NAudio.WinMM.dll" />
    </ItemGroup>

    <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
        <Copy SourceFiles="@(RuntimeDependency)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <!-- Copies the main compiled DLL -->
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
        <!-- Copies the dependencies JSON configuration -->
        <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
        <!-- Copies managed audio dependencies required by the music player -->
        <Copy SourceFiles="@(RuntimeDependency)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyAstralMenuToAmongUs" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Among Us\BepInEx\plugins\"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(RuntimeDependency)"
              DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Among Us\BepInEx\plugins\"
              SkipUnchangedFiles="true" />
    </Target>
</Project>